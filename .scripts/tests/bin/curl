#!/bin/bash
# Serves a tag's Package.swift from $STUB_DIR/manifests, or a 404 like raw.githubusercontent.com.
echo "curl $*" >> "$STUB_DIR/calls.log"
url=${!#}
manifest="$STUB_DIR/manifests/$(basename "$(dirname "$url")")/Package.swift"
if [[ ! -f $manifest ]]; then echo "curl: (22) The requested URL returned error: 404" >&2; exit 22; fi
cat "$manifest"
